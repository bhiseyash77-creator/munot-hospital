# ---- Database (MySQL 8) ----
DB_URL=jdbc:mysql://localhost:3306/munot_hospital?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=munot_app
DB_PASSWORD=Bhiseyash77@gmail.com

# ---- Security (REQUIRED) ----
# At least 32 characters. Generate with:  openssl rand -base64 48
JWT_SECRET=DemoOnly_MunotHospital_Secret_1234567890_ABCDEFGHIJKLMNOPQRSTUVWXYZ
JWT_EXPIRATION_MINUTES=480
# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://https://drmunotorthopaediccare.netlify.app/

# ---- App ----
PORT=8080
APP_TIMEZONE=Asia/Kolkata
UPLOAD_DIR=./uploads
# true only on a local/demo database: creates fictional demo users with publicly documented passwords
SEED_DEMO=false
# set true only while developing to expose Swagger UI / OpenAPI docs
SWAGGER_ENABLED=false

# ---- Email (leave blank to disable email notifications) ----
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---- WhatsApp (leave blank to disable) ----
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ---- SMS (leave blank to disable) ----
SMS_API_URL=
SMS_API_TOKEN=

# ---- First admin (used ONLY on first start when the users table is empty) ----
# Sign in, change the password in the app, then remove ADMIN_PASSWORD from this file.
ADMIN_EMAIL=bhiseyash77@gmail.com
ADMIN_PASSWORD=Bhiseyash77@gmail.com
ADMIN_NAME=Hospital Admin

# ---- Machine translation for free-text advice (OPTIONAL) ----
# Common prescription wording (frequency, timing, durations, standard advice) is translated to Marathi/Hindi by a built-in glossary
# with NO provider. Set these only if you also want arbitrary sentences translated. Provider: google | libretranslate.
# Only the advice text is sent - never patient names or identifiers.
TRANSLATE_PROVIDER=
TRANSLATE_API_URL=
TRANSLATE_API_KEY=
